/**
 * 主應用邏輯
 * 
 * 依賴：config.js, api.js
 */

const App = {
    /**
     * 初始化應用
     */
    async init() {
        // 等待 DOM 載入完成
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => this.start());
        } else {
            this.start();
        }
    },

    /**
     * 啟動應用
     */
    async start() {
        try {
            // 載入資料
            await this.loadData();
        } catch (error) {
            console.error('應用啟動失敗:', error);
            this.showError('頁面載入失敗，請重新整理重試');
        }
    },

    /**
     * 載入資料
     */
    async loadData() {
        this.showLoading();

        try {
            // 並行載入多個資料源
            const [products, news] = await Promise.all([
                this.loadProducts(),
                this.loadNews()
            ]);

            // 渲染資料
            this.renderProducts(products);
            this.renderNews(news);

        } catch (error) {
            console.error('資料載入失敗:', error);
            this.showError('資料載入失敗，請重新整理重試');
        } finally {
            this.hideLoading();
        }
    },

    /**
     * 載入產品資料
     */
    async loadProducts() {
        const data = await API.getRows(CONFIG.WORKSHEETS.PRODUCTS, {
            filter: {
                type: 'group',
                logic: 'AND',
                children: [{
                    type: 'condition',
                    field: CONFIG.PRODUCT_FIELDS.PUBLISHED,
                    operator: 'eq',
                    value: ['1']
                }]
            },
            sorts: [{
                field: CONFIG.PRODUCT_FIELDS.SORT,
                isAsc: true
            }],
            pageSize: 20
        });

        return data.rows || [];
    },

    /**
     * 載入新聞資料
     */
    async loadNews() {
        const data = await API.getRows(CONFIG.WORKSHEETS.NEWS, {
            filter: {
                type: 'group',
                logic: 'AND',
                children: [{
                    type: 'condition',
                    field: CONFIG.NEWS_FIELDS.IS_PUBLISHED,
                    operator: 'eq',
                    value: ['1']
                }]
            },
            sorts: [{
                field: CONFIG.NEWS_FIELDS.PUBLISH_DATE,
                isAsc: false
            }],
            pageSize: 10
        });

        return data.rows || [];
    },

    /**
     * 渲染產品清單
     */
    renderProducts(products) {
        const container = document.getElementById('products-container');
        if (!container) return;

        if (products.length === 0) {
            container.innerHTML = '<p class="empty-message">暫無產品資料</p>';
            return;
        }

        container.innerHTML = products.map(product => {
            const name = API.getFieldValue(product, CONFIG.PRODUCT_FIELDS.NAME);
            const image = API.getImageUrl(product, CONFIG.PRODUCT_FIELDS.IMAGE, 300);
            const price = API.getFieldValue(product, CONFIG.PRODUCT_FIELDS.PRICE);
            const desc = API.getFieldValue(product, CONFIG.PRODUCT_FIELDS.DESC);

            return `
                <div class="product-card">
                    <img src="${image}" alt="${name}" onerror="this.src='placeholder.png'">
                    <h3>${name}</h3>
                    <p class="price">¥${price}</p>
                    <p class="desc">${desc}</p>
                </div>
            `;
        }).join('');
    },

    /**
     * 渲染新聞清單
     */
    renderNews(news) {
        const container = document.getElementById('news-container');
        if (!container) return;

        if (news.length === 0) {
            container.innerHTML = '<p class="empty-message">暫無新聞資料</p>';
            return;
        }

        container.innerHTML = news.map(item => {
            const title = API.getFieldValue(item, CONFIG.NEWS_FIELDS.TITLE);
            const coverImage = API.getImageUrl(item, CONFIG.NEWS_FIELDS.COVER_IMAGE, 400);
            const summary = API.getFieldValue(item, CONFIG.NEWS_FIELDS.SUMMARY);
            const publishDate = API.getFieldValue(item, CONFIG.NEWS_FIELDS.PUBLISH_DATE);

            return `
                <article class="news-item">
                    <img src="${coverImage}" alt="${title}" onerror="this.src='placeholder.png'">
                    <div class="news-content">
                        <h3>${title}</h3>
                        <p class="summary">${summary}</p>
                        <time>${publishDate}</time>
                    </div>
                </article>
            `;
        }).join('');
    },

    /**
     * 顯示載入狀態
     */
    showLoading() {
        const loading = document.getElementById('loading');
        if (loading) loading.style.display = 'block';
    },

    /**
     * 隱藏載入狀態
     */
    hideLoading() {
        const loading = document.getElementById('loading');
        if (loading) loading.style.display = 'none';
    },

    /**
     * 顯示錯誤訊息
     */
    showError(message) {
        const errorDiv = document.createElement('div');
        errorDiv.className = 'error-message';
        errorDiv.textContent = message;
        document.body.appendChild(errorDiv);
        setTimeout(() => errorDiv.remove(), 5000);
    }
};

// 啟動應用
App.init();
